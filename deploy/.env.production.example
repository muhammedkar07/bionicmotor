# ÜRETİM ORTAMI — bionicmotorsiklet.com/bionic
# Bu dosyayı sunucuda  .env  olarak kopyalayın:  cp deploy/.env.production.example .env

PORT=3000
NODE_ENV=production

# Genel adres (Paratika dönüş adresi bu değerden üretilir).
# Kökte çalışıyorsanız: https://bionicmotorsiklet.com
# Alt yolda çalışıyorsanız: https://bionicmotorsiklet.com/bionic  (+ BASE_PATH=/bionic)
BASE_PATH=
PUBLIC_URL=https://bionicmotorsiklet.com

# nginx arkasında gerçek istemci IP'si ve HTTPS çerezleri.
TRUST_PROXY=1
COOKIE_SECURE=1
TZ_OFFSET=180

# Kalıcı veri (yedeklenmesi gereken tek klasör).
DATA_DIR=/var/lib/bionic/data
UPLOAD_DIR=/var/lib/bionic/data/uploads

# İlk açılışta oluşturulacak yönetici parolası (en az 14 karakter; büyük/küçük harf, rakam, simge).
ADMIN_PASSWORD=
SEED_DEMO=0

# Otomatik yedekleme
BACKUP_DIR=/var/backups/bionic
BACKUP_HOURLY_KEEP=24
BACKUP_DAILY_KEEP=30
BACKUP_MONTHLY_KEEP=12
# AES-256-GCM şifreleme anahtarı (güçlü ve gizli; KAYBETMEYİN yoksa yedek açılamaz).
BACKUP_ENCRYPT_KEY=
# Off-site yükleme (ör. Cloudflare R2 / Backblaze B2, rclone ile):
# BACKUP_UPLOAD_CMD=rclone copy "{file}" r2:bionic-backups/

# Paratika — CANLI (VPOS) ortamı. Entegrasyon kullanıcısı canlıda ÇALIŞMAZ; ayrı API kullanıcısı gerekir.
PARATIKA_ENV=prod
PARATIKA_MERCHANT=
PARATIKA_MERCHANT_USER=
PARATIKA_MERCHANT_PASSWORD=
PARATIKA_SIMULATE=0

# Paratika mutabakat / süre dolumu (dakika):
#   Ödeme sayfasından vazgeçen kullanıcıların kayıtları bu süreler sonunda otomatik "İptal" edilir.
RECONCILE_MIN_AGE_MIN=2
PAYMENT_EXPIRE_MIN=3
PAYMENT_EXPIRE_MAX_MIN=30
# İptal edilen kayıtların (gecikmiş onay ihtimali) izlenme süresi (saat)
PAYMENT_LATE_CHECK_HOURS=6

# Görsel yükleme: tek renkli (ör. beyaz) arka plan otomatik olarak ŞEFFAFA çevrilir.
# (Karmaşık/desenli arka planlı fotoğraflara dokunulmaz.) Kapatmak için 0 yapın.
UPLOAD_REMOVE_BG=1
