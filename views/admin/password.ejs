<%- include('../partials/admin_head') %>
<h1>Parola Değiştir</h1>
<form method="post" action="/admin/sifre" class="fcard" style="max-width:420px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="fg"><label>Mevcut Parola</label><input type="password" name="current" required autocomplete="current-password"></div>
  <div class="fg"><label>Yeni Parola (en az 8 karakter)</label><input type="password" name="next" required minlength="8" autocomplete="new-password"></div>
  <div class="fg"><label>Yeni Parola (Tekrar)</label><input type="password" name="again" required minlength="8" autocomplete="new-password"></div>
  <div class="fbtn"><button class="btn btn-primary">Güncelle</button></div>
</form>
<%- include('../partials/admin_foot') %>
