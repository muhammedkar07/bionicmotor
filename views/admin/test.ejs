<%- include('../partials/admin_head') %>
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
  <h1 style="margin:0">Sistem Testi</h1>
  <button id="runTest" class="btn">↻ Yeniden Çalıştır</button>
</div>
<p class="muted">Bu sayfa açıldığında tüm sayfalar, şablonlar, veritabanı, ayarlar ve temel iş mantığı otomatik test edilir. <b style="color:#b42318">Kırmızı</b> satırları düzeltip “Yeniden Çalıştır” deyin.</p>
<div id="testTop" class="alert" style="background:#eef1f6;border-color:#d8dce3;color:#333">Testler çalışıyor…</div>
<div id="testResults"></div>
<style>
  .tg{margin:18px 0}
  .tg h3{margin:0 0 8px;font-size:15px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .tg .cnt{font-size:12px;font-weight:400;color:#6b7280}
  .tres{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e1e4e8;border-radius:10px;overflow:hidden}
  .tres td{padding:8px 10px;border-bottom:1px solid #eef0f3;text-align:left;font-size:13px;vertical-align:top}
  .tres tr:last-child td{border-bottom:0}
  .ok{color:#146c2e;font-weight:700}
  .no{color:#b42318;font-weight:700}
  .badge-ok{background:#e7f6ec;color:#146c2e;border:1px solid #b6e0c3;border-radius:100px;padding:2px 10px;font-size:12px}
  .badge-no{background:#f8d7da;color:#842029;border:1px solid #f1aeb5;border-radius:100px;padding:2px 10px;font-size:12px}
</style>
<script src="/static/js/admin-diagnostics.js?v=<%= v %>"></script>
<%- include('../partials/admin_foot') %>
