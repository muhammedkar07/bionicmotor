<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Servis Girişi</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/portal.css">
</head>
<body class="portal">
<% if (flash) { %><div class="alert alert-<%= flash.type %> top"><%= flash.msg %></div><% } %>
<main class="login-box">
  <div class="logo-center big"><%- include('../partials/logo') %></div>
  <form method="post" action="/servis/giris" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Kullanıcı Kodu:<input class="tint" name="code" required autofocus maxlength="50" autocomplete="username"></label>
    <label>Parola:<input class="tint" type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn btn-info btn-block" type="submit">Giriş Yap</button>
  </form>
</main>
</body>
</html>
