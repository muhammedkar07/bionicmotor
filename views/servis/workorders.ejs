<%- include('../partials/servis_head') %>
<div class="pc">
  <h1 class="h5">İş Emirlerim</h1>
  <table class="ptbl striped">
    <thead class="dark"><tr><th>Tarih</th><th>İş Emri No</th><th>Şase No</th><th>Tür</th><th>Açıklama</th><th>Görsel</th><th>Durum</th><th></th></tr></thead>
    <tbody><% rows.forEach(r=>{ %><tr>
      <td><%= dt(r.created_at) %></td><td><%= r.no %></td><td><%= r.serial_no %></td>
      <td><%= r.type&&r.type!==''?r.type:'Belirlenecek' %></td>
      <td><%= r.description %></td>
      <td><% if(r.image){ %><a class="lnk" target="_blank" href="<%= r.image %>">Görüntüle</a><% } %></td>
      <td><%= r.status %><% if(r.type_locked){ %> <small class="muted">(kilitli)</small><% } %></td>
      <td><button type="button" class="btn btn-info btn-sm js-detay" data-no="<%= r.no %>" data-tarih="<%= dt(r.created_at) %>" data-sase="<%= r.serial_no %>" data-model="<%= r.model %>" data-km="<%= r.km %>" data-tur="<%= r.type %>" data-durum="<%= r.status %>" data-aciklama="<%= r.description %>" data-not="<%= r.admin_note %>" data-gorsel="<%= r.image %>">Detay</button></td>
    </tr><% }) %>
    <% if(!rows.length){ %><tr><td colspan="8" class="muted">Kayıt bulunamadı.</td></tr><% } %></tbody>
  </table>
</div>
<div id="woModal" class="womodal" hidden>
  <div class="wobox">
    <h3>İş Emri Detayı</h3>
    <table class="ptbl"><tbody>
      <tr><th>İş Emri No</th><td id="m-no"></td></tr>
      <tr><th>Tarih</th><td id="m-tarih"></td></tr>
      <tr><th>Şase No</th><td id="m-sase"></td></tr>
      <tr><th>Model</th><td id="m-model"></td></tr>
      <tr><th>Km</th><td id="m-km"></td></tr>
      <tr><th>Tür</th><td id="m-tur"></td></tr>
      <tr><th>Durum</th><td id="m-durum"></td></tr>
      <tr><th>Açıklama</th><td id="m-aciklama"></td></tr>
      <tr><th>Yönetici Notu</th><td id="m-not"></td></tr>
      <tr><th>Görsel</th><td id="m-gorsel"></td></tr>
    </tbody></table>
    <div class="fbtn"><button type="button" class="btn" id="m-close">Kapat</button></div>
  </div>
</div>
<script nonce="<%= nonce %>">
(()=>{const m=document.getElementById('woModal');const set=(id,v)=>document.getElementById(id).textContent=(v===''||v==null||v===undefined)?'-':v;document.querySelectorAll('.js-detay').forEach(b=>{b.onclick=()=>{const d=b.dataset;set('m-no',d.no);set('m-tarih',d.tarih);set('m-sase',d.sase);set('m-model',d.model);set('m-km',d.km);set('m-tur',(d.tur&&d.tur!=='')?d.tur:'Belirlenecek');set('m-durum',d.durum);set('m-aciklama',d.aciklama);set('m-not',d.not);document.getElementById('m-gorsel').innerHTML=d.gorsel?'<a class="lnk" target="_blank" href="'+d.gorsel+'">Görüntüle</a>':'-';m.hidden=false;};});document.getElementById('m-close').onclick=()=>m.hidden=true;m.addEventListener('click',e=>{if(e.target===m)m.hidden=true;});})();
</script>
<%- include('../partials/servis_foot') %>
