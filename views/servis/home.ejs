<%- include('../partials/servis_head') %>
<div class="b2b-hero">
<svg viewBox="0 0 700 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Servis">
  <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d8f0e7"/><stop offset="1" stop-color="#eef6ff"/></linearGradient></defs>
  <path d="M120 120c60-90 220-100 330-70 110 30 200 20 230 120 30 100-60 210-150 290-110 100-300 110-390 20C20 400 10 280 120 120z" fill="url(#g)" opacity=".8"/>
  <g fill="#1f7a5a" font-family="Arial Black,Arial,sans-serif" font-weight="900">
    <text x="40" y="440" font-size="250" letter-spacing="-6">SERVİS</text></g>
</svg>
</div>
<% if (unread && unread.length) { %>
<div class="womodal" id="annModal">
  <div class="wobox">
    <h3>🔔 Yeni Duyurular</h3>
    <% unread.forEach(a => { %><div class="ann"><b class="newtag">YENİ</b> <small class="muted"><%= dt(a.created_at) %></small><p class="pre"><%= a.text %></p></div><% }) %>
    <div class="fbtn"><button class="btn btn-success" type="button" data-close="annModal">Kapat</button></div>
  </div>
</div>
<% } %>
<%- include('../partials/servis_foot') %>

