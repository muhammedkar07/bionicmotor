<%- include('../partials/site_head') %>
<section class="wrap section">
  <h2 class="title-red">MODELLER</h2>
  <div class="cards">
    <% models.forEach(m => { %>
    <div class="model-card">
      <div class="model-img"><% if (m.image) { %><img src="<%= m.image %>" alt="<%= m.name %>"><% } else { %><span><%= m.name %></span><% } %></div>
      <h3><%= m.name %></h3>
      <p><%= m.description %></p>
      <ul class="specs">
        <% if (m.cc) { %><li><b>Hacim</b> <%= m.cc %></li><% } %>
        <% if (m.power) { %><li><b>Güç</b> <%= m.power %></li><% } %>
        <% if (m.gearbox) { %><li><b>Şanzıman</b> <%= m.gearbox %></li><% } %>
      </ul>
    </div>
    <% }) %>
  </div>
</section>
<%- include('../partials/site_foot') %>
