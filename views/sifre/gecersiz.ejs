  <p style="margin-top:24px"><a class="btn btn-info btn-block" href="/sifre/unuttum?p=<%= panel %>">YENİ BAĞLANTI İSTE</a></p>
  <p style="text-align:center;margin-top:18px"><a href="<%= loginUrl %>">← Girişe dön</a></p>
</main>
