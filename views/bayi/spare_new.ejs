<%- include('../partials/bayi_head') %>
<div class="pc">
  <h1 class="h5">Yedek Parça Sipariş Oluştur</h1>
  <div class="spare-filter">
    <label>Motor Modeli
      <select id="modelSel"><option value="">Tüm Modeller</option>
        <% models.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
      </select></label>
    <label>Kategori Ara
      <input id="catSearch" placeholder="örn. Fren, Motor, Gövde..." maxlength="80"></label>
    <button type="button" class="btn btn-secondary" id="listele">Listele</button>
  </div>
  <p class="muted" id="filterNote" hidden></p>

  <form method="post" action="/bayi/yedek-parca/yeni" class="shop" id="sform" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div>
      <div class="shop-grid" id="pgrid">
        <% parts.forEach(p => { %>
        <div class="pcard" data-model="<%= p.model_id || '' %>" data-cat="<%= (String(p.code || '') + ' ' + String(p.name || '') + ' ' + String(p.category || '')).toLocaleLowerCase('tr') %>">
          <h4><%= p.name %></h4>
          <div class="pcode"><%= p.code ? p.code + ' · ' : '' %><%= p.category || '' %></div>
          <div class="pprice"><%= money(p.price) %> ₺</div>
          <div class="pmeta">
            <% if ((+p.stock || 0) > 0) { %>
              <span class="stk-var">Stokta Var</span>
              <div class="pbuy">
                <div class="qtybox">
                  <button type="button" class="qbtn qminus" aria-label="Azalt">−</button>
                  <input type="number" class="qin" min="1" value="1" inputmode="numeric" data-max="<%= +p.max_qty || 0 %>">
                  <button type="button" class="qbtn qplus" aria-label="Artır">+</button>
                </div>
                <button type="button" class="btn btn-success btn-sm add" data-id="<%= p.id %>">Sepete Ekle</button>
              </div>
            <% } else { %>
              <span class="stk-yok">Stokta Yok</span>
              <button type="button" class="btn btn-secondary btn-sm notify" data-id="<%= p.id %>">Gelince Haber Ver</button>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% if (!parts.length) { %><p class="muted">Sipariş verilebilecek parça bulunmuyor.</p><% } %>
    </div>

    <aside class="shop-cart">
      <h3>Sepet</h3>
      <div id="cartlines"></div>
      <div class="cart-total"><span>Genel Toplam</span><span id="ctotal">0,00 ₺</span></div>
      <div id="hiddenlines"></div>

      <h3>Ödeme Yöntemi</h3>
      <div class="paym">
        <label><input type="radio" name="pay_method" value="kart" checked> Kredi Kartı</label>
        <label><input type="radio" name="pay_method" value="nakit"> Nakit</label>
        <label><input type="radio" name="pay_method" value="havale"> Havale / EFT</label>
      </div>

      <div id="cardbox" class="box">
        <label>Kart Üzerindeki Ad Soyad<input name="holder" maxlength="80"></label>
        <label>Kart Numarası<input name="number" id="number" inputmode="numeric" maxlength="23"></label>
        <div style="display:flex;gap:10px">
          <label style="flex:1">Ay<select name="month"><option value="">Ay</option><% for (let m=1;m<=12;m++){ %><option value="<%= m %>"><%= String(m).padStart(2,'0') %></option><% } %></select></label>
          <label style="flex:1">Yıl<select name="year"><option value="">Yıl</option><% for (let y=new Date().getFullYear(); y<new Date().getFullYear()+12; y++){ %><option><%= y %></option><% } %></select></label>
          <label style="flex:1">CVC<input name="cvc" inputmode="numeric" maxlength="4"></label>
        </div>
        <table class="ptbl">
          <thead><tr><th>Seç</th><th>Taksit</th><th class="r">Komisyon</th><th class="r">Taksit Tutarı</th><th class="r">Toplam</th></tr></thead>
          <tbody id="itbody"></tbody>
        </table>
      </div>
      <p class="muted" id="cashnote" hidden>Nakit veya Havale / EFT seçildiğinde sipariş yönetici onayı bekler.</p>
      <div id="havalebox" class="box" hidden>
        <p class="alert alert-warning" style="margin-top:0">Havale / EFT işlemlerinde açıklama kısmına <b>bayi kodunuzu ve adınızı soyadınızı</b> yazmayı unutmayınız.</p>
        <label>Gönderen Hesap Ad Soyad:<input name="payer_name" id="payer_name" maxlength="120" placeholder="Havale/EFT'yi gönderen hesabın ad soyadı"></label>
      </div>
      <label>Not:<textarea name="note" rows="2" maxlength="1000"></textarea></label>
      <div style="margin-top:10px"><button class="btn btn-success btn-block" id="sbtn">Öde ve Siparişi Gönder</button></div>
    </aside>
  </form>
</div>
<script>
  const INST = <%- JSON.stringify(inst.map(i => ({ id: i.id, label: i.label, count: i.count, rate: i.rate }))) %>;
  const PARTS = <%- JSON.stringify(parts.map(p => ({ id: p.id, name: p.name, code: p.code, price: +p.price || 0, max: +p.max_qty || 0 }))) %>;
  const OLD = <%- JSON.stringify(old || {}) %>;
  const CSRF = document.querySelector('input[name=_csrf]').value;
  const $ = id => document.getElementById(id);
  const fmt = n => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const part = id => PARTS.find(p => p.id === id);
  let cart = [], total = 0;

  function renderInst() {
    const checked = (document.querySelector('input[name=installment_id]:checked') || {}).value || (INST[0] && INST[0].id);
    $('itbody').innerHTML = INST.map(i => {
      const t = total + total * i.rate / 100;
      return `<tr><td><input type="radio" name="installment_id" value="${i.id}" ${i.id == checked ? 'checked' : ''} style="display:inline;width:auto;margin:0"></td>` +
        `<td>${esc(i.label)}</td><td class="r">%${fmt(i.rate)}</td><td class="r">${fmt(t / i.count)} ₺</td><td class="r">${fmt(t)} ₺</td></tr>`;
    }).join('');
  }
  function render() {
    const box = $('cartlines');
    total = 0;
    box.innerHTML = cart.map(l => {
      const p = part(l.id); const lt = p.price * l.qty; total += lt;
      return `<div class="cartline">` +
        `<div class="cn">${esc((p.code ? p.code + ' - ' : '') + p.name)}<br><small class="muted">${fmt(p.price)} ₺</small></div>` +
        `<div class="lt">${fmt(lt)} ₺</div>` +
        `<div><input type="number" min="1" value="${l.qty}" data-qid="${l.id}"></div>` +
        `<div class="r"><button type="button" class="rm" data-rid="${l.id}">Kaldır</button></div></div>`;
    }).join('');
    if (!cart.length) box.innerHTML = '<p class="shop-empty">Sepetiniz boş. Soldan ürün ekleyin.</p>';
    $('hiddenlines').innerHTML = cart.map(l => `<input type="hidden" name="part_id" value="${l.id}"><input type="hidden" name="qty" value="${l.qty}">`).join('');
    $('ctotal').textContent = fmt(total) + ' ₺';
    renderInst();
  }
  function add(id, qty) {
    const p = part(id); if (!p) return;
    let l = cart.find(x => x.id === id);
    if (!l) { l = { id, qty: 0 }; cart.push(l); }
    l.qty += (qty || 1);
    if (p.max > 0 && l.qty > p.max) l.qty = p.max;
    if (l.qty < 1) l.qty = 1;
    render();
  }
  $('pgrid').addEventListener('click', e => {
    const qb = e.target.closest('.qbtn');
    if (qb) {
      const box = qb.closest('.qtybox'), inp = box && box.querySelector('.qin');
      if (inp) {
        const max = +inp.dataset.max || 0;
        let v = Math.max(1, Math.floor(+inp.value) || 1);
        v = qb.classList.contains('qplus') ? v + 1 : v - 1;
        if (v < 1) v = 1;
        if (max > 0 && v > max) v = max;
        inp.value = v;
      }
      return;
    }
    const a = e.target.closest('.add');
    if (a) {
      const box = a.closest('.pbuy'), inp = box && box.querySelector('.qin');
      const max = inp ? (+inp.dataset.max || 0) : 0;
      let q = inp ? Math.max(1, Math.floor(+inp.value) || 1) : 1;
      if (max > 0 && q > max) q = max;
      add(+a.dataset.id, q);
      return;
    }
    const n = e.target.closest('.notify');
    if (n) {
      const body = new URLSearchParams({ product_id: n.dataset.id, _csrf: CSRF });
      fetch('/bayi/stok-bildirim', { method: 'POST', body }).then(r => r.json()).then(j => {
        n.textContent = j.ok ? 'Haber Verildi ✓' : 'Kaydedilemedi'; n.disabled = !!j.ok;
      }).catch(() => {});
    }
  });
  $('pgrid').addEventListener('change', e => {
    if (!e.target.classList.contains('qin')) return;
    const max = +e.target.dataset.max || 0;
    let v = Math.floor(+e.target.value); if (!(v >= 1)) v = 1;
    if (max > 0 && v > max) v = max;
    e.target.value = v;
  });
  $('cartlines').addEventListener('input', e => {
    if (e.target.dataset.qid) {
      const id = +e.target.dataset.qid, p = part(id);
      let q = Math.floor(+e.target.value) || 1; if (q < 1) q = 1;
      if (p.max > 0 && q > p.max) q = p.max;
      const l = cart.find(x => x.id === id); if (l) l.qty = q;
      render();
    }
  });
  $('cartlines').addEventListener('click', e => {
    const r = e.target.closest('.rm');
    if (r) { cart = cart.filter(l => l.id !== +r.dataset.rid); render(); }
  });
  function applyFilter() {
    const model = $('modelSel').value, q = $('catSearch').value.toLocaleLowerCase('tr').trim();
    let shown = 0;
    $('pgrid').querySelectorAll('.pcard').forEach(c => {
      let ok = true;
      if (model && c.dataset.model !== model) ok = false;
      if (ok && q && !(c.dataset.cat || '').includes(q)) ok = false;
      c.hidden = !ok; if (ok) shown++;
    });
    const mm = $('modelSel').selectedOptions[0];
    $('filterNote').hidden = false;
    $('filterNote').textContent = (mm && mm.value ? mm.textContent + ' modeli için' : 'Tüm modellerde') + ' ' + shown + ' parça listelendi' + (shown === 0 ? '. Lütfen modele uygun bir parça seçin veya kategori aramasını temizleyin.' : '.');
  }
  $('listele').onclick = applyFilter;
  $('catSearch').addEventListener('input', applyFilter);
  $('modelSel').addEventListener('change', applyFilter);

  function method() {
    const m = document.querySelector('input[name=pay_method]:checked').value;
    const card = m === 'kart', havale = m === 'havale';
    $('cardbox').hidden = !card; $('cashnote').hidden = card; $('havalebox').hidden = !havale;
    $('payer_name').required = havale;
    $('sbtn').textContent = card ? 'Öde ve Siparişi Gönder' : 'Siparişi Kaydet';
  }
  document.querySelectorAll('input[name=pay_method]').forEach(r => r.onchange = method);
  $('number').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 19).replace(/(.{4})/g, '$1 ').trim(); });
  $('sform').addEventListener('submit', e => {
    if (!cart.length) { e.preventDefault(); alert('Sepete en az bir parça ekleyin.'); }
  });
  document.querySelectorAll('input[name=pay_method]').forEach(r => { r.checked = r.value === (OLD.pay_method || 'kart'); });
  const setV = (sel, v, f) => { const el = document.querySelector(sel); if (el && v !== undefined && v !== null && v !== '') el.value = f ? f(String(v)) : v; };
  setV('input[name=holder]', OLD.holder);
  setV('input[name=number]', OLD.number, n => n.replace(/\D/g, '').slice(0, 19).replace(/(.{4})/g, '$1 ').trim());
  setV('select[name=month]', OLD.month);
  setV('select[name=year]', OLD.year);
  setV('input[name=cvc]', OLD.cvc);
  setV('textarea[name=note]', OLD.note);
  setV('input[name=payer_name]', OLD.payer_name);
  (OLD.lines || []).filter(l => +l[0] > 0).forEach(l => add(+l[0], Math.max(1, Math.floor(+l[1]) || 1)));
  render();
  if (OLD.installment_id) { const rr = document.querySelector('input[name=installment_id][value="' + OLD.installment_id + '"]'); if (rr) { rr.checked = true; renderInst(); } }
  method();
</script>
<%- include('../partials/bayi_foot') %>
