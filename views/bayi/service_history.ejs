<%- include('../partials/bayi_head') %>
<div class="pc">
  <h1 class="h5">Servis Geçmişi</h1>
  <form class="inline-form" method="get"><input name="q" value="<%= q %>" placeholder="Şase no girin" required><button class="btn btn-success btn-sm">Görüntüle</button></form>
  <table class="ptbl striped">
    <thead class="dark"><tr><th>Tarih</th><th>İş Emri</th><th>Şase No</th><th>Km</th><th>Tür</th><th>Açıklama</th><th>Durum</th></tr></thead>
    <tbody><% rows.forEach(r => { %><tr><td><%= dt(r.created_at) %></td><td><%= r.no %></td><td><%= r.serial_no %></td><td><%= r.km %></td><td><%= r.type %></td><td><%= r.description %></td><td><%= r.status %></td></tr><% }) %>
    <% if (!rows.length) { %><tr><td colspan="7" class="muted"><%= q ? 'Kayıt bulunamadı.' : 'Şase no girerek servis geçmişini görüntüleyin.' %></td></tr><% } %></tbody>
  </table>
</div>
<%- include('../partials/bayi_foot') %>
