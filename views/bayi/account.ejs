<%- include('../partials/bayi_head') %>
<div class="pc">
  <h1 class="h5"><%= heading %> (<%= bf.name %>)</h1>
  <% if (typeof receipt !== 'undefined' && receipt) { %>
  <div class="alert alert-success" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap">
    <span>✅ Ödemeniz alındı: <b><%= money(receipt.amount_tl) %> ₺</b> · hesabınıza alacak işlendi.</span>
    <a class="btn btn-success btn-sm" href="/odeme/dekont/<%= receipt.id %>" target="_blank" rel="noopener">Dekont</a>
  </div>
  <% } %>
  <form method="get" class="dfilter">
    <label>Başlangıç<input type="date" name="from" value="<%= from || '' %>"></label>
    <label>Bitiş<input type="date" name="to" value="<%= to || '' %>"></label>
    <button class="btn btn-sm btn-info" type="submit">Filtrele</button>
    <% if (from || to) { %><a class="btn btn-sm" href="<%= selfPath %>">Temizle</a><% } %>
  </form>
  <% if (from || to) { %><p class="muted" style="margin:-6px 0 12px">Seçili dönem: <b><%= from || 'başlangıç' %></b> – <b><%= to || 'bugün' %></b></p><% } %>
  <% if (showCards) { %>
  <div class="cards4">
    <div class="stat bg-green"><div><%= from || to ? 'Dönem Başı Bakiye' : 'Önceki Dönemden Devir' %></div><b><%= money(a.opening) %> ₺</b></div>
    <div class="stat bg-cyan"><div>Dönem İçi Satışlar</div><b><%= money(a.sales) %> ₺</b></div>
    <div class="stat bg-yellow"><div>Vadesi Gelmemiş Çekler</div><b><%= money(a.pendingChecks) %> ₺</b></div>
    <div class="stat bg-blue"><div>Kredi Kartı Ödemeleri</div><b><%= money(a.card) %> ₺</b></div>
    <div class="stat bg-yellow"><div>Bekleyen Siparişler</div><b><%= money(a.pendingOrders) %> ₺</b></div>
    <div class="stat bg-red stat-balance"><div>Bakiye</div><b><%= money(a.balance) %> ₺</b></div>
  </div>
  <hr>
  <% } else { %>
  <p class="muted">Bakiye: <b><%= money(a.balance) %> ₺</b></p>
  <% } %>
  <h2 class="h6">Hesap Hareketleri</h2>
  <table class="ptbl striped">
    <thead class="dark"><tr><th>Tarih</th><th>Ödeme Türü</th><th>Dekont</th><th class="r">Tutar</th><th class="r">Bakiye</th></tr></thead>
    <tbody>
    <% a.rows.forEach(r => { %>
      <tr><td><%= date(r.date) %></td>
        <td><%= r.doc_type %></td>
        <td><% if (r.receipt) { %><a href="<%= r.receipt %>" target="_blank" class="lnk">Görüntüle</a><% } %></td><td class="r"><%= money(r.amount) %></td>
        <td class="r"><b><%= r.kind==='bilgi' ? '' : money(r.balance) %></b></td></tr>
    <% }) %>
    <% if (!a.rows.length) { %><tr><td colspan="5" class="muted">Hareket bulunamadı.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/bayi_foot') %>
