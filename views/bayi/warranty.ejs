<%- include('../partials/bayi_head') %>
<div class="pc">
  <h1 class="h5">Garanti Sorgulama</h1>
  <p class="muted">Şase numarası ile aracın garanti durumunu sorgulayın.</p>
  <form class="inline-form" method="get" action="/bayi/garanti">
    <input name="q" value="<%= q %>" placeholder="Şase no girin" required maxlength="40">
    <button class="btn btn-success btn-sm">Sorgula</button>
  </form>
  <% if (q) { %>
    <% if (rows.length) { %>
      <p class="alert alert-success" style="max-width:600px">Bu şase için garanti kaydı <b>bulundu</b>.</p>
      <table class="ptbl striped">
        <thead class="dark"><tr><th>Şase No</th><th>Model</th><th>Müşteri</th><th>Fatura No</th><th>Satış Tarihi</th><th>Garanti Bitiş</th><th>Durum</th></tr></thead>
        <tbody><% rows.forEach(r => { %><tr><td><%= r.serial_no %></td><td><%= r.model %></td><td><%= r.customer %></td><td><%= r.invoice_no %></td><td><%= dateSlash(r.sale_date) %></td><td><%= dateSlash(r.warranty_end) %></td><td><%= r.status %></td></tr><% }) %></tbody>
      </table>
    <% } else { %>
      <p class="alert alert-danger" style="max-width:600px">Bu şase numarası için garanti kaydı <b>bulunamadı</b>.</p>
    <% } %>
  <% } %>
</div>
<%- include('../partials/bayi_foot') %>
