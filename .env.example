# Sunucu
PORT=3000
NODE_ENV=production

# Gösterimde kullanılan saat dilimi farkı (dakika). Türkiye (UTC+3) = 180. Varsayılan: 180.
TZ_OFFSET=180

# İlk kurulumda oluşturulacak yönetici parolası (canlıda zorunlu).
# En az 14 karakter, bir büyük harf, bir küçük harf, bir rakam ve bir simge içermelidir.
ADMIN_PASSWORD=

# Demo bayi ve örnek finansal verileri oluşturmak için 1 yapın (canlıda 0 bırakın).
SEED_DEMO=0
# Demo bayi parolası (yalnızca SEED_DEMO=1 iken kullanılır).
DEMO_PASSWORD=demo1234Ab!

# HTTPS arkasında çerezleri "Secure" yapar.
COOKIE_SECURE=0
# nginx/IIS gibi bir ters proxy arkasındaysanız gerçek istemci IP'si için 1 yapın.
TRUST_PROXY=0

# Kalıcı disk yolları (opsiyonel; platformlarda volume bağlayın).
DATA_DIR=
UPLOAD_DIR=

# Otomatik yedek (SQLite) — açılışta + saatlik, rotasyonlu; en yeni N adet saklanır.
# BACKUP_DIR=/var/backups/bionic
# BACKUP_HOURLY_KEEP=24
# BACKUP_DAILY_KEEP=30
# BACKUP_MONTHLY_KEEP=12
# Yedekleri şifrele (AES-256-GCM). Güçlü, gizli bir anahtar verin.
# BACKUP_ENCRYPT_KEY=
# Off-site yükleme komutu. {file} yer tutucusu yedek dosyasıyla değiştirilir.
# Örn (rclone/Cloudflare R2):  rclone copy "{file}" r2:bionic-backups/ --s3-no-check-bucket
# Örn (rclone/Backblaze B2):   rclone copy "{file}" b2:bionic-backups/
# Örn (aws s3):                aws s3 cp "{file}" s3://bionic-backups/
# BACKUP_UPLOAD_CMD=

# Dış erişim adresi (ters proxy arkasında Paratika dönüş adresi için doğru olmalı).
# ALT YOL DAHİL tam adres olmalı. Örn: https://bionicmotorsiklet.com/bionic
PUBLIC_URL=

# Uygulamanın yayınlandığı alt yol (subpath). Kökte çalışıyorsa BOŞ bırakın.
# Örn: /bionic  (https://site/bionic/ altında çalışır)
BASE_PATH=

# ---- Paratika Sanal POS (Web POS / barındırılan ödeme sayfası) ----
# Paratika'nın vereceği üye işyeri bilgileri.
# PARATIKA_MERCHANT = Üye İşyeri Numarası (sayısal), _USER = API kullanıcı adı (e-posta), _PASSWORD = API şifresi.
PARATIKA_MERCHANT=
PARATIKA_MERCHANT_USER=
PARATIKA_MERCHANT_PASSWORD=
# 'test' (varsayılan) veya 'prod'
PARATIKA_ENV=test
# Gerekirse uç noktaları elle geçersiz kılın (varsayılanlar test/prod'a göre ayarlanır).
# test: https://entegrasyon.paratika.com.tr  |  prod: https://vpos.paratika.com.tr
# PARATIKA_API_BASE=https://entegrasyon.paratika.com.tr/paratika/api/v2
# PARATIKA_HPP_URL=https://entegrasyon.paratika.com.tr/payment/{token}
# Ağ isteği yapmadan başarılı ödeme simüle eder (yalnızca geliştirme/test).
PARATIKA_SIMULATE=0

# ---- E-posta (şifre sıfırlama bağlantıları) ----
# Boş bırakılırsa "Şifremi Unuttum" e-postası GÖNDERİLMEZ (arayüz bunu bildirir).
# Oracle Cloud Email Delivery (Frankfurt): port 587 + STARTTLS (SMTP_SECURE=0)
# Veridyen (cPanel/Exim):                port 465 + SSL         (SMTP_SECURE=1)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Bionic Motor
