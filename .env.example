# Sunucu
PORT=3000
NODE_ENV=production

# İlk kurulumda oluşturulacak yönetici parolası (canlıda zorunlu).
# En az 14 karakter, bir büyük harf, bir küçük harf, bir rakam ve bir simge içermelidir.
ADMIN_PASSWORD=

# Demo bayi ve örnek finansal verileri oluşturmak için 1 yapın (canlıda 0 bırakın).
SEED_DEMO=0
# Demo bayi parolası (yalnızca SEED_DEMO=1 iken kullanılır).
DEMO_PASSWORD=demo1234Ab!

# HTTPS arkasında çerezleri "Secure" yapar.
COOKIE_SECURE=0
# nginx/IIS gibi bir ters proxy arkasındaysanız gerçek istemci IP'si için 1 yapın.
TRUST_PROXY=0

# Kalıcı disk yolları (opsiyonel; platformlarda volume bağlayın).
DATA_DIR=
UPLOAD_DIR=

# Otomatik yedek (SQLite) — günlük çalışır, en yeni N adet saklanır.
# BACKUP_DIR=/var/backups/bionic
# BACKUP_KEEP=10

# Dış erişim adresi (ters proxy arkasında Paratika dönüş adresi için doğru olmalı).
# Örn: https://bayi.ornek.com
PUBLIC_URL=

# ---- Paratika Sanal POS (Web POS / barındırılan ödeme sayfası) ----
# Paratika'nın vereceği üye işyeri bilgileri.
PARATIKA_MERCHANT=
PARATIKA_MERCHANT_USER=
PARATIKA_MERCHANT_PASSWORD=
# 'test' (varsayılan) veya 'prod'
PARATIKA_ENV=test
# Gerekirse uç noktaları elle geçersiz kılın (varsayılanlar teste göre ayarlanır).
# PARATIKA_API_BASE=https://test.paratika.com.tr/paratika/api/v2
# PARATIKA_HPP_URL=https://test.paratika.com.tr/paratika/hpp/{token}
# Ağ isteği yapmadan başarılı ödeme simüle eder (yalnızca geliştirme/test).
PARATIKA_SIMULATE=0
