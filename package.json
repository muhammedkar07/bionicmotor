{
  "name": "bionic-b2b",
  "version": "1.0.0",
  "private": true,
  "description": "Kurumsal site + Bayi (B2B) paneli + Yönetim paneli",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "node scripts/demo.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:login": "cloudflared tunnel login",
    "tunnel:create": "cloudflared tunnel create bionic-demo",
    "tunnel:run": "cloudflared tunnel run bionic-demo",
    "seed": "node scripts/seed.js",
    "seed:models": "node scripts/seed-models.js",
    "seed:faqs": "node scripts/seed-faqs.js",
    "seed:about": "node scripts/seed-about.js",
    "seed:pages": "node scripts/seed-pages.js",
    "seed:kvkk": "node scripts/seed-kvkk.js",
    "pack": "node scripts/pack.js",
    "reconcile": "node scripts/reconcile.js",
    "reset:data": "node scripts/reset-data.js",
    "clean:demo": "node scripts/clean-demo.js",
    "baseline": "node scripts/baseline.js",
    "reset": "node scripts/reset.js",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/backup-verify.js",
    "restore": "node scripts/restore.js",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "seed:test": "node scripts/seed-test-data.js",
    "push:test": "powershell -ExecutionPolicy Bypass -File deploy/push-to-test.ps1",
    "promote": "powershell -ExecutionPolicy Bypass -File deploy/promote.ps1",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "typecheck": "tsc --noEmit",
    "mail:test": "node --env-file=.env scripts/mail-test.js",
    "seo:audit": "node scripts/seo-audit.js",
    "mail:check": "node --env-file=.env scripts/mail-check.js",
    "mail:auth": "node --env-file=.env scripts/mail-auth-test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
