{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["server.js", "db.js", "lib/**/*.js", "routes/**/*.js", "scripts/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "public", "tests", "demo-data", "data"]
}
